{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "loader.ts",
    "report/**/*.ts",
    "scripts/**/*.ts",
    "plugins/**/index.ts",
    "plugins/types/**/*.ts",
    "plugins/utils/**/*.ts",
    "tests/loader.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "audit.ts",
    "plugins/loader.ts",
    "plugins/**/tests/**"
  ]
}
